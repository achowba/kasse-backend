# Copy to .env and fill in. Never commit .env.

# Runtime
NODE_ENV=development
PORT=1413
LOG_LEVEL=debug

# Database.
# Transactions need a replica set, so `docker compose up -d` starts a single
# node one. `directConnection=true` talks to that member directly instead of
# going through replica set discovery, which keeps the same URI working whether
# the caller runs on the host or inside a container.
MONGODB_URI=mongodb://localhost:27017/plan_vs_actual?directConnection=true

# Auth.
#
# Access tokens are signed with RS256: the private key signs, the public key
# verifies. Another service can validate a token with the public key alone,
# without holding anything able to mint one.
#
# Both are base64 encoded PEMs, because a PEM has newlines and an environment
# variable is a single line. Generate a pair with:
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
#   base64 < private.pem | tr -d '\n'   # JWT_PRIVATE_KEY
#   base64 < public.pem  | tr -d '\n'   # JWT_PUBLIC_KEY
#
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=900

# Refresh tokens are opaque random bytes, not JWTs, so they need no key. They are
# stored only as a hash and rotate on every use.
JWT_REFRESH_TTL_DAYS=7

# CORS. Comma separated list of allowed origins.
CORS_ORIGINS=http://localhost:3001

# Rate limiting. The credential routes are limited harder than the rest, because
# they are the brute force surface.
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000
# Tighter per account limits on the two most expensive routes. A report is an
# aggregation across two collections; an import parses megabytes and writes
# thousands of rows in one transaction.
REPORT_THROTTLE_LIMIT=60
IMPORT_THROTTLE_LIMIT=6

AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_MS=60000

# Natural language query. Optional.
# When unset, POST /reports/nl-query returns 503 and the rest of the API is
# unaffected.
ANTHROPIC_API_KEY=
