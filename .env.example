# Copy to .env and fill in. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database.
# Transactions need a replica set, which is why the local URI names one.
# `docker compose up -d` starts a single node replica set that satisfies this.
MONGODB_URI=mongodb://localhost:27017/plan_vs_actual?replicaSet=rs0

# Auth. Generate each secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

# CORS. Comma separated list of allowed origins.
CORS_ORIGINS=http://localhost:3001

# Natural language query. Optional.
# When unset, POST /reports/nl-query returns 503 and the rest of the API is
# unaffected.
ANTHROPIC_API_KEY=
